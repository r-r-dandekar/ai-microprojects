### From progress-tracker
# Dependencies
node_modules/
app/node_modules/

# Build output
app/dist/

# Environment variables (contain secrets)
app/.env
app/.env.local
app/.env.*.local

# Logs
*.log
npm-debug.log*

# Editor
.vscode/
.idea/
*.suo
*.user

# OS
.DS_Store
Thumbs.db

# Vitest cache
app/.vitest/



# ==========================================
# 1. C++ Compiled Binaries & Build Artifacts
# ==========================================
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# CMake build directories
/build/
/cmake-build-*/

# Microsoft Visual Studio artifacts
/.vs/
/x64/
/x86/
/Release/
/Debug/
*.suo
*.user
*.ncb
*.sdf
*.opensdf
*.vcproj.*.user

# Xcode artifacts
*.mode1v3
*.mode2v3
*.storyboardc
## This ignores local Xcode user state but keeps project structure
xcuserdata/

# ==========================================
# 2. VST / Audio Plugin Specifics
# ==========================================
# Ignore the final built plugin binaries locally (they should be generated by your installer/build script)
*.vst/
*.vst3/
*.component/
*.app/
*.aaxplugin/

# Juce / Projucer artifacts (if using JUCE)
/JuiceLibraryCode/
/Builds/

# ==========================================
# 3. Audio Hosts / DAW Testing Artifacts
# ==========================================
# DAWs often dump crash logs, temporary settings, or memory dumps into the project folder during debugging
*.log
*.dmp
*.crash
.DS_Store
Thumbs.db

# ==========================================
# 4. Package Managers & Dependencies
# ==========================================
# If using vcpkg or Conan for package management, ignore their local setups
/vcpkg_installed/
/conan/
progress-tracker/app/.env
